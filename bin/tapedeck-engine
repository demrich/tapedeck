#!/bin/sh
# TAPEDECK engine: librespot (Spotify Connect device) -> raw PCM -> PulseAudio.
# librespot's subprocess backend starts pacat on play and kills it on pause/stop, so no
# stream stays open while idle: an open (even silent) stream keeps the HDA codec awake and
# the CPU package out of deep C-states, which costs battery.
# Player events are appended to $EVENTS as key=value lines; the UI watches it with inotify.
set -eu
# Private run dir: never a shared /tmp path another user could pre-create or symlink.
RUN="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/haven/tapedeck/run}/tapedeck"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/haven/tapedeck/librespot"
BITRATE="${TAPEDECK_BITRATE:-160}"
mkdir -p "$CACHE"
mkdir -p -m 700 "$RUN"
LIBRESPOT="${LIBRESPOT:-$(command -v librespot || echo "$HOME/.cargo/bin/librespot")}"
: > "$RUN/events"
exec "$LIBRESPOT" \
    --name TAPEDECK \
    --device-type speaker \
    --backend subprocess \
    --device "pacat --raw --format=s16le --rate=44100 --channels=2 --client-name=TAPEDECK --stream-name=TAPEDECK --latency-msec=200" \
    --bitrate "$BITRATE" \
    --cache "$CACHE" \
    --disable-audio-cache \
    --enable-oauth \
    --disable-discovery \
    --initial-volume 70 \
    --enable-volume-normalisation \
    --autoplay on \
    --onevent "$(dirname "$(readlink -f "$0")")/tapedeck-onevent"
