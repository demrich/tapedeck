#!/bin/sh
# Install TAPEDECK for this user: menu entry, engine user service, LCD font.
set -eu
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
FONTS="${XDG_DATA_HOME:-$HOME/.local/share}/fonts"
mkdir -p "$APPS" "$UNITS" "$FONTS"
sed "s|^Exec=.*|Exec=$HERE/bin/tapedeck|" "$HERE/tapedeck.desktop" > "$APPS/tapedeck.desktop"
ln -sf "$HERE/systemd/tapedeck-engine.service" "$UNITS/tapedeck-engine.service"
systemctl --user daemon-reload
for f in "$HERE"/../../shared/fonts/VT323*.ttf; do
  [ -e "$f" ] && cp -u "$f" "$FONTS/"
done
fc-cache -f "$FONTS" >/dev/null 2>&1 || true
update-desktop-database "$APPS" >/dev/null 2>&1 || true
echo "installed: menu entry, tapedeck-engine.service (start on demand; 'systemctl --user enable tapedeck-engine' to run from login)"
